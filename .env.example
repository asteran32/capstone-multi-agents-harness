# python3 scripts/configure.py creates .env with random local credentials.
APP_USERNAME=researcher
APP_PASSWORD=
POSTGRES_PASSWORD=
SANDBOX_TOKEN=
PORT=8000
# docker executes original tests; mock explicitly reports not_executed.
SANDBOX_MODE=docker
# Optional. No paid calls occur with the default mock model.
OPENAI_API_KEY=
# Shared allowlist for Agent, Judge, and stored-response reevaluation.
OPENAI_MODELS=gpt-5.4-nano,gpt-5.6-luna
